# Optional AI provider. Leave empty to use deterministic template summaries.
AI_PROVIDER=

# OpenAI configuration. Keep real keys in your local shell or Coolify environment.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional local model configuration.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1

# Next.js runtime configuration.
PORT=3000
METSATARK_BASE_PATH=
NEXT_PUBLIC_METSATARK_BASE_PATH=

# Optional JSON-line log file path for server diagnostics.
METSAPEEGEL_LOG_FILE=
